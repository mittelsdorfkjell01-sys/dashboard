# Python
__pycache__/
*.py[cod]
.venv/
.venv*/
*.egg-info/
.pytest_cache/

# Env — never commit real secrets. Only the *.example templates are tracked.
.env
.env.tide
data/fes*/
data/tide-model*/
.env.*
!.env.example
# frontend/.env.production holds only the public same-origin API base (VITE_API_URL=/api),
# no secrets — Vite's idiomatic committed prod config, so keep it tracked.
!frontend/.env.production
# (env.prod.example has no leading dot, so it is not matched above and stays tracked.)

# Backups (pg_dump / media tarballs written on the host)
/backups/

# ERA5 raw extracts (downloaded data, not source)
/data/era5_raw/

# Reproducible CDSE/WorldCover runtime cache (multi-GB; reports retain hashes).
/data/geodata-cache/

# OS
.DS_Store
Thumbs.db

# Local screenshots / runtime media (not source)
screens/
/data/media/

# local-only DB connection string for one-off migrations (never commit)
scripts/.neon_url

# local-only Vercel API token (never commit)
scripts/.vercel_token

# local-only MapTiler API key
scripts/.maptiler_key

# local-only DB connection string (never commit)
scripts/.db_url

# local Vercel CLI project metadata
.vercel
