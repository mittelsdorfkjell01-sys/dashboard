{
  "name": "surfwinddate-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:release": "node scripts/check-legal.mjs && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src",
    "check:bundle": "node scripts/check-bundle.mjs",
    "i18n:report": "node scripts/i18n-report.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "i18next": "26.7.2",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.27",
    "maplibre-gl": "^6.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "17.1.13",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.5",
    "supercluster": "8.0.1"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supercluster": "7.1.3",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
