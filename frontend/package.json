{
  "name": "surfwinddate-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "tsc -b && vite build --mode e2e",
    "build:release": "node scripts/check-legal.mjs && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test",
    "lint": "eslint src",
    "check:bundle": "node scripts/check-bundle.mjs",
    "i18n:report": "node scripts/i18n-report.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "i18next": "26.4.4",
    "leaflet": "1.9.4",
    "lenis": "^1.3.27",
    "maplibre-gl": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "17.0.16",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.6",
    "supercluster": "8.0.1"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supercluster": "7.1.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
